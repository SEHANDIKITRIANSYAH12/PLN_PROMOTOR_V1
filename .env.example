# ==============================================================================
#  Konfigurasi database aplikasi Promotor PLN
#
#  Salin berkas ini menjadi .env lalu sesuaikan:
#      cp .env.example .env
#
#  PostgreSQL yang dipakai proyek ini adalah instance Homebrew lokal
#  (postgresql@14). pg_hba.conf-nya "trust" untuk 127.0.0.1/::1, jadi role
#  di bawah memang tidak memakai password.
#
#  Membuat role + database sekali saja:
#      createuser -U <role_superuser_anda> promotor_app
#      createdb -U <role_superuser_anda> -O promotor_app promotor_pln
#      psql -U promotor_app -d promotor_pln -c 'ALTER ROLE promotor_app CREATEDB'
#      npx prisma migrate deploy
#
#  JANGAN mengarahkan URL ini ke database `promotor` -- itu database proyek
#  Promotor lama dan berisi data produksi.
# ==============================================================================

DATABASE_URL="postgresql://promotor_app@localhost:5432/promotor_pln?schema=public"
