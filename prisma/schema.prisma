// ============================================================
//  SKEMA PROMOTOR V1.0 -- dipetakan 1:1 dari tipe TypeScript
//  di src/types/index.ts, BUKAN dari desain skema lama.
//
//  Aturan rancangan:
//  1. Entitas yang aplikasinya berubah record-per-record (survey, WO,
//     kontrak, stok, sweeping) menjadi tabel dengan kolom bertipe.
//  2. Baris item di dalam dokumen yang ikut dimutasi (tiang survey,
//     material WO, jasa WO) diturunkan menjadi tabel anak ber-FK,
//     onDelete: Cascade.
//  3. Payload yang sifatnya dokumen sekali-tulis (foto base64, daftar
//     surat jalan, override RAB, milestones) disimpan sebagai Json.
//     Ini kompromi yang disengaja pada tahap awal; bisa dinormalisasi
//     menyusul kalau mulai dibutuhkan query per baris.
//  4. ID memakai kunci aplikasi yang sudah ada (SRV-2026-0001, nomor WO)
//     supaya deterministik dan mudah di-upsert. GENERATED ID dihindari.
//  5. Kolom `status`, `createdAt`, `validFrom` disimpan sebagai String
//     persis seperti bentuk datanya di aplikasi. Aplikasi memakai label
//     bahasa Indonesia ("Siap Apply WO") dan tanggal tampilan
//     ("11 Nov 2026 08:45"); dikonversi ke enum/DateTime hanya akan
//     merusak tampilan dan memaksa lapisan terjemahan di mana-mana.
//     Kolom sysCreatedAt/sysUpdatedAt di bawah ini yang jadi jejak waktu
//     sungguhan untuk debugging.
//  6. Uang memakai Float (bukan Decimal). Kesengajaan: JS hanya punya
//     number, dan Decimal Prisma datang sebagai objek yang pecah kalau
//     masuk ke aritmetika harga. Nominal di sini masih aman di double.
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------
// 1. SURVEY PELANGGAN & TIANG (SurveyRecord / PoleData)
// ------------------------------------------------------------
model Survey {
  id           String  @id
  customerName String
  namaDasar    String?
  jumlahUnit   Int?
  dayaPerUnit  String?
  idpel        String?
  jobType      String
  status       String
  createdAt    String

  location     String
  address      String?
  latitude     Float?
  longitude    Float?
  coordStr     String?
  kampung      String?
  desa         String?
  kecamatan    String?
  kabupaten    String?
  officerName  String?

  dayaLama     String?
  tarifLama    String?
  dayaBaru     String?
  tarifBaru    String?
  daya         String?
  tarif        String?

  garduInduk            String?
  penyulang             String?
  gardu                 String?
  ulp                   String?
  perluasanJTM          String?
  tipePembangunanGardu  String?
  tipeGardu             String?
  kapasitasTrafo        String?
  jumlahKabelNaik       String?
  perluasanJTR          String?
  trafoLama             String?
  trafoBaru             String?
  jenisPekerjaanGardu   String?
  jumlahKubikelLBS      String?

  paymentStatus      String?
  paymentDate        String?
  nidi               Boolean?
  slo                Boolean?
  originalCustomerName String?
  isNameChanged      Boolean?

  isOfflineDraft   Boolean?
  offlineCreatedAt String?
  syncedAt         String?

  locationPhotos     String[] @default([])
  rabCustomOverrides Json     @default("{}")

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt

  poles SurveyPole[] @relation("SurveyPoles")

  @@index([status])
  @@index([idpel])
}

/// Tiang hasil survey. `id` adalah label per-survey (TM-1, TR-2) sehingga
/// tidak unik global -- kunci utamanya gabungan surveyId + id.
model SurveyPole {
  surveyId        String
  id              String
  idx             Int      @default(0)
  name            String
  std             String
  networkType     String?
  poleStatus      String?
  poleType        String?
  tmConstruction  String?
  trConstruction  String?
  a3cs            String?
  lvTwisted       String?
  conductorLength Float?
  qty             Int      @default(1)
  coordStr        String   @default("")
  lat             Float?
  lng             Float?
  note            String   @default("")
  photo           String?
  materialOverrides Json    @default("{}")

  survey Survey @relation("SurveyPoles", fields: [surveyId], references: [id], onDelete: Cascade)

  @@id([surveyId, id])
}

// ------------------------------------------------------------
// 2. DAFTUNG (DaftungRecord)
// ------------------------------------------------------------
model Daftung {
  id              String  @id
  idpel           String
  customerName    String
  source          String
  woIssued        String
  nidi            Boolean @default(false)
  slo             Boolean @default(false)
  status          String
  surveyId        String?
  rejectionReason String?
  daya            String?
  tarif           String?
  ulp             String?
  location        String?

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt

  @@index([surveyId])
}

// ------------------------------------------------------------
// 3. WORK ORDER (WorkOrderRecord)
// ------------------------------------------------------------
model WorkOrder {
  id           String  @id
  customerName String
  idpel        String
  category     String
  vendor       String
  supervisor   String
  progress     Float   @default(0)
  status       String
  reservationStatus String @default("Belum Reservasi")

  daya         String?
  tarif        String?
  location     String?
  address      String?
  garduInduk   String?
  penyulang    String?
  gardu        String?
  ulp          String?
  tipePembangunanGardu String?
  kapasitasTrafo       String?
  jumlahKabelNaik      String?

  contractId   String?
  spkNumber    String?
  validFrom    String?
  validTo      String?
  supervisor1  String?
  supervisor2  String?
  noWorkOrder  String?
  narahubung   String?
  phone        String?

  progressMaterial Float?
  progressJasa     Float?
  milestones       Json?

  approvalStatus    String?
  rejectionReason   String?
  approvedAt        String?
  submittedToAsmanAt String?
  appliedAt         String?
  daftungId         String?
  surveyId          String?

  reservationLink            String?
  reservationExpiry          DateTime?
  reservationNumber          String?
  reservationNumberNonStock  String?
  reservationDate            String?
  reservationNotes           String?
  reservationNotesNonStock   String?

  giNumber   String?
  giStatus   String?
  giCatatan  String?
  giInputDate String?
  giInputBy   String?

  isHold     Boolean?
  holdReason String?

  materialSubstitutions Json @default("[]")

  vendorReceiptConfirmed  Boolean?
  vendorReceiptDate       String?
  vendorReceiptNotes      String?
  vendorRealizationSubmitted Boolean?
  vendorRealizationDate      String?
  vendorRealizationNotes     String?

  pengawasRealizationVerified    Boolean?
  pengawasRealizationVerifiedAt  String?
  pengawasRealizationVerifiedBy  String?
  pengawasRealizationNotes       String?

  suratJalanNumber          String?
  suratJalanNumberNonStock  String?
  suratJalanPhoto           String?
  suratJalanPhotos          String[]  @default([])
  suratJalanList            Json      @default("[]")
  suratJalanDate            String?
  receiptPhotos             String[]  @default([])

  sjVerificationStatus String?
  sjVerifiedAt         String?
  sjVerifiedBy         String?
  sjVerificationNotes  String?

  slipReturNumber String?
  slipReturDate   String?
  slipReturPhotos String[] @default([])
  returStatus     String?
  returApprovedAt String?
  returApprovedBy String?
  returRejectedAt String?
  returRejectedBy String?
  returRejectionReason String?
  returNotes           String?

  rabCustomOverrides Json @default("{}")

  approverName     String?
  approverRole     String?
  approverSignature String?
  creatorName      String?
  creatorRole      String?
  creatorSignature String?
  catatan          String?

  pendingJasaItems   Json     @default("[]")
  progressStatus     String?
  progressSubmittedAt String?
  progressSubmittedBy String?
  progressVerifiedAt  String?
  progressVerifiedBy  String?
  progressRejectedReason String?

  // Progres jasa dikunci pengawas: vendor tidak boleh mengirim update lagi,
  // status WO menjadi 'Closeout'. Status sebelumnya disimpan untuk buka kunci.
  progressJasaLocked Boolean?
  progressLockedAt   String?
  progressLockedBy   String?
  statusBeforeCloseout String?

  // Volume rencana direvisi Asman sebelum approval: dokumen WO memakai volume WO.
  volumeEditedAt String?
  volumeEditedBy String?

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt

  materials WoMaterial[] @relation("WoMaterials")
  jasaItems WoJasa[]     @relation("WoJasaItems")

  @@index([status])
  @@index([daftungId])
  @@index([surveyId])
  @@index([contractId])
}

/// Material WO. Barisnya ikut dimutasi satu per satu (reservasi,
/// pengambilan, verifikasi pengawas, retur) sehingga layak jadi tabel.
model WoMaterial {
  woId               String
  idx                Int
  material           String
  qtyReksis          Float    @default(0)
  qtyAllocated       Float    @default(0)
  qtyReserved        Float?
  qtyReservedSap     Float?
  qtyReservedNonSap  Float?
  qtyTaken           Float?
  qtyTakenSap        Float?
  qtyTakenNonSap     Float?
  isTaken            Boolean?
  takenAt            String?
  qtyInstalled       Float?
  qtyReturned        Float?
  isVerified         Boolean?
  verificationNote   String?
  unit               String   @default("")
  kategori           String?
  hargaSatuan        Float?
  kode               String?
  isReplaced         Boolean?
  originalMaterialName String?
  isHold             Boolean?
  holdReason         String?
  vendorNotes        String?
  stockType          String?

  workOrder WorkOrder @relation("WoMaterials", fields: [woId], references: [id], onDelete: Cascade)

  @@id([woId, idx])
}

/// Item pekerjaan/jasa dari RAB yang jadi dasar realisasi lapangan.
model WoJasa {
  woId            String
  idx             Int
  id              String?
  kode            String?
  deskripsi       String
  subKategori     String?
  qtyTarget       Float    @default(0)
  qtyRealisasi    Float    @default(0)
  unit            String   @default("")
  hargaSatuan     Float?
  bobotPersen     Float?
  progresPersen   Float?
  catatan         String?
  kendala         String?
  evidencePhoto   String?
  evidenceCaption String?

  workOrder WorkOrder @relation("WoJasaItems", fields: [woId], references: [id], onDelete: Cascade)

  @@id([woId, idx])
}

// ------------------------------------------------------------
// 4. HISTORI TRANSAKSI RESERVASI & PENGAMBILAN
//    Rekaman sekali-tulis; daftar itemnya disimpan sebagai dokumen Json.
// ------------------------------------------------------------
model ReservationTransaction {
  id                         String  @id
  woId                       String
  noWorkOrder                String
  date                       String
  supervisorName             String
  vendorName                 String
  customerName               String
  category                   String
  reservationNumberStock     String?
  reservationNumberNonStock  String?
  notes                      String?
  items                      Json    @default("[]")

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())

  @@index([woId])
}

model VendorPickupTransaction {
  id                String  @id
  woId              String
  noWorkOrder       String
  date              String
  vendorName        String
  supervisorName    String
  customerName      String
  suratJalanNumber  String
  reservationNumber String?
  giNumber          String?
  suratJalanPhotos  String[] @default([])
  notes             String?
  items             Json     @default("[]")
  status            String?
  verifiedAt        String?
  verifiedBy        String?
  verificationNotes String?

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())

  @@index([woId])
}

// ------------------------------------------------------------
// 5. DATA MASTER
// ------------------------------------------------------------
model Vendor {
  id             String  @id
  name           String
  director       String
  address        String
  npwp           String?
  phone          String
  email          String
  jenisPekerjaan String[] @default([])
  validFrom      String
  validTo        String
  status         String
  bankAccount    String?
  paketType      String?

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt
}

model Contract {
  id              String  @id
  spkNumber       String
  title           String
  vendorId        String
  vendorName      String
  jenisPekerjaan  String
  tipePengadaan   String
  nilaiKontrak    Float   @default(0)
  totalPagu       Float   @default(0)
  usedPagu        Float   @default(0)
  sisaPagu        Float   @default(0)
  validFrom       String
  validTo         String
  nomorAmandemen  String?
  amandemenWaktu  String?
  supervisorId    String?
  supervisorName  String?
  supervisorRole  String?
  status          String
  createdAt       String
  paketType       String?

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([spkNumber])
}

model MaterialContract {
  id               String  @id
  notaDinas        String
  tanggalNotaDinas String?
  judulPengadaan   String?
  nilaiRabNodin    Float   @default(0)
  nomorSpk         String
  namaVendor       String
  nilaiSpk         Float   @default(0)
  validFrom        String
  validTo          String
  status           String
  keterangan       String?

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt

  rincian MaterialContractItem[] @relation("MaterialContractRincian")

  @@index([nomorSpk])
}

model MaterialContractItem {
  kontrakId   String
  id          String
  idx         Int       @default(0)
  kode        String?
  deskripsi   String
  satuan      String
  volume      Float   @default(0)
  hargaSatuan Float   @default(0)
  totalHarga  Float   @default(0)
  keterangan  String?

  kontrak MaterialContract @relation("MaterialContractRincian", fields: [kontrakId], references: [id], onDelete: Cascade)

  @@id([kontrakId, id])
}

model Supervisor {
  id       String  @id
  name     String
  role     String
  category String
  unit     String
  nip      String?
  phone    String?
  status   String

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt
}

/// Stok gudang. Kuncinya `code`, sama seperti di aplikasi (bukan id).
model Stock {
  code          String  @id
  name          String
  category      String
  qtyFisik      Float   @default(0)
  qtySap        Float?
  qtyMrwi       Float?
  qtyAlokasi    Float   @default(0)
  qtySisa       Float   @default(0)
  unit          String
  status        String
  lastUpdatedAt String?

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt

  @@index([category])
}

/// Terjemahan kode material lama -> nomor material, dipakai Master Material.
model MaterialCodeMapping {
  key   String @id
  value String
}

// ------------------------------------------------------------
// 6. SWEEPING MATERIAL (SweepingRecord / SweepingMaterialItem)
// ------------------------------------------------------------
model Sweeping {
  id             String  @id
  nomorSweeping  String
  namaPekerjaan  String
  noSpk          String
  tanggal        String
  lokasi         String
  pelaksana      String
  status         String
  createdAt      String
  catatan        String?
  ttdVendorName  String?
  ttdPengawasName String?
  ttdGudangName   String?
  woIds          String[] @default([])

  sysIdx       Int      @default(0)
  sysCreatedAt DateTime @default(now())
  sysUpdatedAt DateTime @updatedAt

  items SweepingItem[] @relation("SweepingItems")

  @@index([noSpk])
}

model SweepingItem {
  sweepingId     String
  id             String
  idx            Int      @default(0)
  kode           String?
  material       String
  volPengambilan Float  @default(0)
  satPengambilan String @default("")
  noTug9         String?
  ketPengambilan String?
  volTerpasang   Float  @default(0)
  satTerpasang   String @default("")
  ketTerpasang   String?
  volDikembalikan Float @default(0)
  satDikembalikan String @default("")
  noTug10        String?
  ketDikembalikan String?

  sweeping Sweeping @relation("SweepingItems", fields: [sweepingId], references: [id], onDelete: Cascade)

  @@id([sweepingId, id])
}

// ------------------------------------------------------------
// 7. KONFIGURASI & AUDIT
// ------------------------------------------------------------
/// Aturan dropdown standar konstruksi (JTM/JTR). Satu baris per jaringan,
/// daftar tiang & konstruksinya pakai array Postgres, bukan tabel terpisah.
model ConstructionRule {
  network         String  @id
  tiangLabel      String
  konstruksiLabel String
  conductorLabel  String
  tiangList       String[] @default([])
  konstruksiList  String[] @default([])

  sysUpdatedAt DateTime @updatedAt
}

/// Harga KHS yang diubah manual (customKhsPrices).
model KhsPrice {
  itemId String  @id
  price  Float   @default(0)
}

/// Log audit. Tidak punya kunci alami di aplikasi, jadi pakai bigserial.
model Audit {
  seq      Int     @id @default(autoincrement())
  time     String
  user     String
  activity String
  object   String
  source   String
  sysIdx   Int      @default(0)

  @@index([time])
}
